# keep shell scripts LF (they run in Linux containers / CI even when the
# repo is cloned on Windows with autocrlf)
*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# binaries
*.png binary
*.db binary
*.exe binary
