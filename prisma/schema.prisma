// TrafficLab — Prisma schema
// Run history for the traffic simulation engine.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Run {
  id         String    @id // generated by the dashboard, shared with engine-service
  domain     String
  threads    Int
  minClicks  Int
  maxClicks  Int
  timeout    Int
  maxOffset  Int
  secure     Boolean
  forever    Boolean
  useProxies Boolean
  status     String // running | completed | stopped | failed | interrupted
  visits     Int      @default(0) // page visits generated
  bounces    Int      @default(0) // back-navigations
  linksFound Int      @default(0) // links discovered
  startedAt  DateTime @default(now())
  endedAt    DateTime?
  error      String?
}
