# TrafficLab environment
# Copy to .env (the setup script does this for you) and adjust as needed.

# SQLite database location — MUST be absolute (Prisma + standalone server resolve it literally)
DATABASE_URL=file:/absolute/path/to/trafficlab/db/custom.db

# ---- optional overrides (defaults are fine for single-server local use) ----

# Where the Python engine lives (default: <repo>/engine — the engine-service
# finds it automatically; override only for custom layouts)
# ENGINE_DIR=/absolute/path/to/engine

# engine-service REST base as seen by the Next.js server
# (override only for hybrid deployments where the engine runs on another machine)
# ENGINE_REST_URL=http://127.0.0.1:3004

# Where engine-service POSTs run-end snapshots back to the dashboard
# NEXT_APP_URL=http://127.0.0.1:3000

# engine-service ports (defaults shown)
# PORT=3003
# REST_PORT=3004

# ---- build-time (browser) socket connection --------------------------------
# Leave BOTH unset for the sandbox preview. For a self-hosted server behind the
# provided Caddyfile, build with:
#   NEXT_PUBLIC_ENGINE_SOCK_PATH=/engine-socket/socket.io
# (npm run build:prod does this automatically)
# For a dedicated engine origin instead:
#   NEXT_PUBLIC_ENGINE_SOCK_URL=https://engine.example.com

# ---- python engine (optional, auto-discovered if unset) --------------------
# CHROME_BINARY=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
