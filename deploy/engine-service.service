# ============================================================================
# TrafficLab engine-service — systemd unit
# Install:
#   sudo cp deploy/engine-service.service /etc/systemd/system/
#   # edit WorkingDirectory to your clone path
#   sudo systemctl daemon-reload && sudo systemctl enable --now engine-service
# ============================================================================

[Unit]
Description=TrafficLab engine-service (socket.io bridge + Python engine supervisor)
After=network.target trafficlab.service

[Service]
Type=simple
User=trafficlab
Group=trafficlab
WorkingDirectory=/opt/trafficlab/mini-services/engine-service
# No --hot in production; plain bun executes index.ts directly.
ExecStart=/usr/bin/bun index.ts
Environment=NODE_ENV=production
Environment=ENGINE_DIR=/opt/trafficlab/engine
Environment=DATABASE_URL=file:/opt/trafficlab/db/custom.db
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
